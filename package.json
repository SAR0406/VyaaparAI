{
  "name": "vyapaarai",
  "version": "0.1.0",
  "description": "AI Business Operating System for India's 63 million MSMEs via WhatsApp",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "db:migrate": "node src/db/migrate.js",
    "lint": "eslint src/ --ext .js"
  },
  "keywords": [
    "whatsapp",
    "msme",
    "india",
    "gst",
    "ai",
    "vernacular",
    "hindi",
    "business"
  ],
  "author": "Sarthak Upadhyay",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "pg": "^8.11.0",
    "pdfkit": "^0.14.0",
    "razorpay": "^2.9.0",
    "winston": "^3.11.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "supertest": "^6.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage"
  }
}
