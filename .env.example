# ========================
# VyapaarAI Environment Variables
# Copy this file to .env and fill in your credentials
# ========================

# ── WhatsApp Business API ───────────────────────────────────────
# Get these from Meta Business Dashboard or 360dialog/Twilio
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_API_VERSION=v19.0
# App Secret from Meta Developer Console — used to verify webhook signatures (REQUIRED in production)
WHATSAPP_APP_SECRET=your_meta_app_secret

# ── Claude AI (Anthropic) ───────────────────────────────────────
# Get your key at https://console.anthropic.com
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ── PostgreSQL Database ─────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/vyapaarai
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vyapaarai
DB_USER=postgres
DB_PASSWORD=your_db_password

# ── Razorpay Payments ───────────────────────────────────────────
# Get keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Webhook secret from Razorpay dashboard — used to verify payment webhook signatures
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── GST / Government APIs ───────────────────────────────────────
# Free APIs from the Indian Government
GST_API_BASE_URL=https://api.gst.gov.in
GSTIN_VALIDATION_API_URL=https://api.gst.gov.in/commonapi/V1.1/search
IRP_API_URL=https://api.gstsystem.co.in/eivital/v1.04
SANDBOX_MODE=true

# ── Application ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=https://your-app-url.vercel.app
# Number of reverse proxies in front of the app (1 for most PaaS deployments)
TRUST_PROXY=1

# ── Subscription Plans (in paise — 1 INR = 100 paise) ──────────
PLAN_STARTER_AMOUNT=49900
PLAN_GROWTH_AMOUNT=99900
PLAN_ENTERPRISE_AMOUNT=299900
